# doesitfire reads keys from environment variables only. Copy to .env and
# load it with your shell or direnv; doesitfire never reads this file itself.
# You only need the ones your doesitfire.yaml uses. Local Ollama needs none.

# OLLAMA_HOST=http://localhost:11434
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=      # Claude subscription token from `claude setup-token`
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
